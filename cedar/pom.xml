<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.floci.sidecar</groupId>
    <artifactId>floci-sidecars</artifactId>
    <version>0.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>floci-sidecar-cedar</artifactId>
  <name>Cedar Sidecar</name>
  <description>Cedar 4 policy parsing, schema validation and authorization over HTTP</description>

  <properties>
    <cedar.version>4.10.0</cedar.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.floci.sidecar</groupId>
      <artifactId>sidecar-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.cedarpolicy</groupId>
      <artifactId>cedar-java</artifactId>
      <version>${cedar.version}</version>
      <classifier>uber</classifier>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- A stable jar name so the Dockerfile never carries a version. -->
    <finalName>sidecar</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-runtime-dependencies</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.directory}/dependency</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
